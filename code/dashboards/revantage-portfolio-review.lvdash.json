{
  "datasets": [
    {
      "name": "kpi_latest",
      "displayName": "Portfolio KPIs, 2026-Q2 (metric views)",
      "queryLines": [
        "SELECT m.revenue, m.net_profit, m.net_profit_margin, t.target_attainment, t.properties_met_target, t.properties, g.qoq_net_profit_growth\n",
        "FROM (SELECT MEASURE(revenue) AS revenue, MEASURE(net_profit) AS net_profit, MEASURE(net_profit_margin) AS net_profit_margin\n",
        "      FROM ref_mv_net_profit_margin WHERE fiscal_quarter = '2026-Q2') m\n",
        "CROSS JOIN (SELECT MEASURE(target_attainment) AS target_attainment, MEASURE(properties_met_target) AS properties_met_target,\n",
        "                   MEASURE(properties) AS properties FROM ref_mv_target_attainment WHERE fiscal_quarter = '2026-Q2') t\n",
        "CROSS JOIN (SELECT MEASURE(qoq_net_profit_growth) AS qoq_net_profit_growth FROM ref_mv_qoq_revenue_growth WHERE fiscal_quarter = '2026-Q2') g\n"
      ]
    },
    {
      "name": "trend_region",
      "displayName": "Net profit and margin by quarter and region (metric view)",
      "queryLines": [
        "SELECT fiscal_quarter, region_name, property_type, MEASURE(revenue) AS revenue, MEASURE(net_profit) AS net_profit\n",
        "FROM ref_mv_net_profit_margin\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "property_quarter",
      "displayName": "Property x quarter (certified gold)",
      "queryLines": [
        "SELECT property_name, property_type, region_name, market, fiscal_quarter, revenue, revenue_target, net_profit,\n",
        "       net_profit_target, net_profit - net_profit_target AS variance_to_target, met_target, qoq_change_pct,\n",
        "       CASE WHEN qoq_change_pct < -10 THEN 'Sharp decline' WHEN qoq_change_pct < 0 THEN 'Decline' ELSE 'OK' END AS qoq_flag\n",
        "FROM gold_property_quarterly\n"
      ]
    },
    {
      "name": "market_qoq",
      "displayName": "QoQ net profit growth by market (metric view)",
      "queryLines": [
        "SELECT market, fiscal_quarter, region_name, MEASURE(qoq_net_profit_growth) AS qoq_net_profit_growth\n",
        "FROM ref_mv_qoq_revenue_growth\n",
        "WHERE fiscal_quarter >= '2024-Q2'\n",
        "GROUP BY ALL\n"
      ]
    },
    {
      "name": "forecast",
      "displayName": "Revenue actuals + ai_forecast with 95% interval (Demo 14)",
      "queryLines": [
        "SELECT property_name, region_name, property_type, fiscal_quarter_date, series, value FROM (\n",
        "  SELECT property_name, region_name, property_type, fiscal_quarter_date,\n",
        "         stack(5, 'Actual', revenue_actual, 'Forecast', revenue_forecast, 'Lower 95%', revenue_lower,\n",
        "                  'Upper 95%', revenue_upper, 'Target', revenue_target) AS (series, value)\n",
        "  FROM ref_d14_revenue_forecast)\n",
        "WHERE value IS NOT NULL\n",
        "UNION ALL\n",
        "-- anchor the forecast and interval lines on the last actual so they connect\n",
        "SELECT property_name, region_name, property_type, fiscal_quarter_date, s.series, revenue_actual\n",
        "FROM ref_d14_revenue_forecast\n",
        "CROSS JOIN (SELECT explode(array('Forecast', 'Lower 95%', 'Upper 95%')) AS series) s\n",
        "WHERE fiscal_quarter = '2026-Q2'\n"
      ]
    }
  ],
